{
  "installCommand": "cd frontend && npm install --ignore-scripts",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,docs/**,backend/tests/**,backend/storage_data/**,backend/alembic/**,**/node_modules/**,**/__pycache__/**,**/.venv/**}",
      "includeFiles": "backend/app/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
