# ============================================================
# CreatorAI — environment configuration
# Copy to .env and fill in. NEVER commit .env or real keys.
# Every value here is read by the BACKEND ONLY.
# ============================================================

# --- App ---
ENV=development
DEBUG=true
API_PREFIX=/api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL 16+ with the pgvector extension) ---
DATABASE_URL=postgresql+psycopg2://creatorai:creatorai@localhost:5432/creatorai

# --- Auth ---
# Generate with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ============================================================
# AI PROVIDERS
# Leave GEMINI_API_KEY empty to run the whole app in clearly
# labelled DEMO MODE — every AI result is badged "Demo" in the
# UI and no external call is made.
# Get a free key: https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# --- Speech to text ---
# "gemini"  = transcribe with Gemini (default, no extra install)
# "openai"  = OpenAI Whisper API (requires OPENAI_API_KEY)
STT_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# --- Image generation (thumbnails) ---
# "none"   = no image generation; the Thumbnail Studio falls back to
#            extracted video frames + text-overlay templates (fully working)
# "gemini" = Gemini image model
# "openai" = OpenAI image model (requires OPENAI_API_KEY)
IMAGE_PROVIDER=none
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Storage ---
STORAGE_BACKEND=local
MAX_UPLOAD_MB=500
USER_QUOTA_MB=2048

# --- Processing ---
VIDEO_FRAME_SAMPLES=12
JOB_CONCURRENCY=2
